{
  "//": "Copy to <repoRoot>/.agents/ticket-loop.config.json and edit for your stack. This is what makes ticket-loop work beyond Flutter/Figma. Three examples below — keep ONE. The 'hooks' block drives the plugin's enforcement hooks (post_edit + stop_gate); without it the hooks are inert and only the skill's prompts protect you.",

  "//flutter-frontend": {
    "stack": "flutter",
    "ticketSource": "jira",
    "designSource": "figma",
    "verify": {
      "analyze": "dart analyze",
      "test": "flutter test --exclude-tags golden",
      "pubGet": "flutter pub get",
      "codegen": "dart run build_runner build --delete-conflicting-outputs"
    },
    "riskPaths": ["lib/ui/auth/**", "lib/data/services/api/**", "pubspec.yaml"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "dart-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "hooks": {
      "postEdit": {
        "extensions": [".dart"],
        "exclude": "\\.(g|freezed|tailor|gr|config|gen)\\.dart$",
        "format": "dart format {file}",
        "analyze": "dart analyze {file}",
        "analyzeErrorRegex": "\\berror\\b\\s*[-•]|^\\s*error\\b"
      },
      "stopGate": {
        "extensions": [".dart"],
        "exclude": "\\.(g|freezed|tailor|gr|config|gen)\\.dart$",
        "mode": "targeted",
        "testDir": "test",
        "testSuffix": "_test.dart",
        "excludeTests": ["test/golden/", "_golden_test.dart"],
        "testCommand": "flutter test {targets} --reporter compact",
        "flakeSignatures": [
          "PathExistsException",
          "errno = 183",
          "flutter_test_compiler",
          "Cannot create a file when that file already exists"
        ],
        "failureMarkers": ["Some tests failed", "Expected:", "Actual:"],
        "timeoutMs": 240000
      }
    }
  },

  "//python-backend": {
    "stack": "python",
    "ticketSource": "github",
    "designSource": "openapi",
    "verify": {
      "analyze": "ruff check . && mypy .",
      "test": "pytest -q",
      "pubGet": "pip install -e .",
      "codegen": null
    },
    "riskPaths": ["**/migrations/**", "**/auth/**", "**/settings*.py", "pyproject.toml"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "django-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "hooks": {
      "postEdit": {
        "extensions": [".py"],
        "format": "ruff format {file}",
        "analyze": "ruff check {file}"
      },
      "stopGate": {
        "extensions": [".py"],
        "mode": "full",
        "timeoutMs": 300000
      }
    }
  },

  "//go-service": {
    "stack": "go",
    "ticketSource": "gitlab",
    "designSource": "none",
    "verify": {
      "analyze": "go vet ./...",
      "test": "go test ./...",
      "pubGet": "go mod download",
      "codegen": "go generate ./..."
    },
    "riskPaths": ["**/auth/**", "**/migrations/**", "go.mod"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "go-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "hooks": {
      "postEdit": {
        "extensions": [".go"],
        "format": "gofmt -w {file}"
      },
      "stopGate": {
        "extensions": [".go"],
        "mode": "full",
        "timeoutMs": 300000
      }
    }
  }
}
