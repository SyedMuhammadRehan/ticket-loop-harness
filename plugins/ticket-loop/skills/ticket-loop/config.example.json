{
  "//": "Copy to <repoRoot>/.agents/ticket-loop.config.json and edit for your stack. This is what makes ticket-loop work beyond Flutter/Figma. Three examples below — keep ONE. The 'hooks' block drives the plugin's enforcement hooks (post_edit + stop_gate); without it those two hooks are inert and only the skill's prompts protect you. freeze_guard and dispatch_guard work regardless.",
  "//security": "WARNING: the strings in verify.* and hooks.* are EXECUTED by the plugin's hooks, which run without a permission prompt. This file is therefore as trusted as code. Never accept it unreviewed from a cloned repo — see the Security section in INSTALL.md.",
  "//stopGate-keys": "baseRef: the branch point used to detect COMMITTED changes (the loop commits every green slice, so a git-status-only check would see nothing). worktrees: all|ticket|cwd — 'all' also covers detached-HEAD and non-ticket/* branches. requireMatchingTest: block when a changed source file has no matching test (targeted mode). timeoutMs is floored at 30s and a timeout BLOCKS rather than passing as 'not verified'.",

  "//flutter-frontend": {
    "stack": "flutter",
    "ticketSource": "jira",
    "designSource": "figma",
    "verify": {
      "analyze": "dart analyze",
      "test": "flutter test --exclude-tags golden",
      "pubGet": "flutter pub get",
      "codegen": "dart run build_runner build --delete-conflicting-outputs"
    },
    "riskPaths": ["lib/ui/auth/**", "lib/data/services/api/**", "pubspec.yaml"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "dart-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "attribution": {
      "//": "commitTrailer: string to append to every worktree commit (for repos that REQUIRE disclosure), or null for clean commits with no AI attribution. Repo policy decides — the default is null.",
      "commitTrailer": null
    },
    "hooks": {
      "postEdit": {
        "extensions": [".dart"],
        "exclude": "\\.(g|freezed|tailor|gr|config|gen)\\.dart$",
        "format": "dart format {file}",
        "analyze": "dart analyze {file}",
        "analyzeErrorRegex": "\\berror\\b\\s*[-•]|^\\s*error\\b"
      },
      "stopGate": {
        "extensions": [".dart"],
        "exclude": "\\.(g|freezed|tailor|gr|config|gen)\\.dart$",
        "mode": "targeted",
        "worktrees": "all",
        "baseRef": "main",
        "requireMatchingTest": true,
        "testDir": "test",
        "testSuffix": "_test.dart",
        "excludeTests": ["test/golden/", "_golden_test.dart"],
        "testCommand": "flutter test {targets} --reporter compact",
        "flakeSignatures": [
          "PathExistsException",
          "errno = 183",
          "flutter_test_compiler",
          "Cannot create a file when that file already exists"
        ],
        "failureMarkers": ["Some tests failed", "Expected:", "Actual:"],
        "timeoutMs": 240000
      }
    }
  },

  "//python-backend": {
    "stack": "python",
    "ticketSource": "github",
    "designSource": "openapi",
    "verify": {
      "analyze": "ruff check . && mypy .",
      "test": "pytest -q",
      "pubGet": "pip install -e .",
      "codegen": null
    },
    "riskPaths": ["**/migrations/**", "**/auth/**", "**/settings*.py", "pyproject.toml"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "django-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "hooks": {
      "postEdit": {
        "extensions": [".py"],
        "format": "ruff format {file}",
        "analyze": "ruff check {file}"
      },
      "stopGate": {
        "extensions": [".py"],
        "mode": "full",
        "worktrees": "all",
        "baseRef": "main",
        "timeoutMs": 300000
      }
    }
  },

  "//go-service": {
    "stack": "go",
    "ticketSource": "gitlab",
    "designSource": "none",
    "verify": {
      "analyze": "go vet ./...",
      "test": "go test ./...",
      "pubGet": "go mod download",
      "codegen": "go generate ./..."
    },
    "riskPaths": ["**/auth/**", "**/migrations/**", "go.mod"],
    "worktreePrefix": "../ticket-",
    "buildResolverAgent": "go-build-resolver",
    "memoryFile": ".agents/ticket-loop-memory.md",
    "hooks": {
      "postEdit": {
        "extensions": [".go"],
        "format": "gofmt -w {file}"
      },
      "stopGate": {
        "extensions": [".go"],
        "mode": "full",
        "worktrees": "all",
        "baseRef": "main",
        "timeoutMs": 300000
      }
    }
  }
}
