{
  "stack": "node",
  "ticketSource": "manual",
  "designSource": "none",
  "verify": {
    "analyze": null,
    "test": "node tests/run.js",
    "pubGet": null,
    "codegen": null
  },
  "riskPaths": [
    "plugins/ticket-loop/hooks/freeze_guard.js",
    "plugins/ticket-loop/hooks/guard_policy.js",
    "plugins/ticket-loop/hooks/dispatch_guard.js",
    "plugins/ticket-loop/hooks/stop_gate.js",
    "plugins/ticket-loop/skills/ticket-loop/scripts/chain.js",
    "plugins/ticket-loop/skills/ticket-loop/scripts/ledger.js",
    ".claude-plugin/**",
    ".github/workflows/**"
  ],
  "worktreePrefix": "../ticket-",
  "buildResolverAgent": null,
  "memoryFile": ".agents/ticket-loop-memory.md",
  "hooks": {
    "postEdit": {
      "extensions": [".js"],
      "analyze": "node --check {file}"
    },
    "stopGate": {
      "extensions": [".js"],
      "mode": "full",
      "worktrees": "all",
      "baseRef": "main",
      "timeoutMs": 180000
    }
  }
}
